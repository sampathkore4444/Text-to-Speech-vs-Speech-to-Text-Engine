# Copy to `.env` (docker-compose loads it automatically) and adjust.

# Which config file to use
SPEECHAI_CONFIG=configs/config.yaml

# API
SPEECHAI_API__PORT=8000
# Set a value to require an X-API-Key header on everything except /health, /metrics, /docs
SPEECHAI_API__API_KEY=

# Storage
SPEECHAI_STORAGE__DATA_DIR=data

# STT model - larger = more accurate but slower. base is a good CPU default.
SPEECHAI_STT__MODEL_SIZE=base
# Point to a LoRA fine-tuned CTranslate2 export (takes precedence over MODEL_SIZE)
SPEECHAI_STT__MODEL_PATH=
SPEECHAI_STT__DEVICE=auto
SPEECHAI_STT__COMPUTE_TYPE=auto
# Pin a language (e.g. en) for lower latency; leave empty for auto-detect
SPEECHAI_STT__LANGUAGE=

# TTS
SPEECHAI_TTS__VOICE=en_US-lessac-medium

# Queue - memory works for a single process; use redis for horizontal scale-out
SPEECHAI_QUEUE__BACKEND=memory
SPEECHAI_QUEUE__REDIS_URL=redis://localhost:6379/0

# PII redaction (banking security)
SPEECHAI_REDACTION__ENABLED=true
SPEECHAI_REDACTION__MODE=mask
